{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?path=:path*" }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "data": false
    }
  }
}
